# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://omc_user:omc_pass@localhost:5432/omc_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_32chars_min
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=noreply@onemillioncoders.io

# ─── App ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000

# ─── Credentials ──────────────────────────────────────────────────────────────
CREDENTIAL_VERIFY_BASE_URL=http://localhost:4000/credentials/verify

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Admin ────────────────────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@onemillioncoders.io
INITIAL_ADMIN_PASSWORD=CHANGE_ME_admin_password
